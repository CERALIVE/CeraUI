{
	"name": "frontend",
	"private": true,
	"version": "2026.6.1",
	"description": "A modern UI built with Svelte + Vite for CeraLive streaming hardware.",
	"type": "module",
	"author": "Andr\u00e9s Cera",
	"license": "GPL-3.0",
	"scripts": {
		"dev": "vite",
		"build": "bun run generate:i18n && vite build",
		"build:federation": "bun run generate:i18n && vite build --config vite.federation.config.ts",
		"preview": "vite preview",
		"check": "bun run generate:i18n && svelte-check --tsconfig ./tsconfig.app.json",
		"lint": "echo 'Frontend linting handled by root Biome'",
		"lint:fix": "echo 'Frontend fixing handled by root Biome'",
		"fix": "echo 'Frontend fixing handled by root Biome'",
		"test": "bun run generate:i18n && vitest run && bun run test:hardware-preflight",
		"test:hardware-preflight": "node --test ../../scripts/input-picker-hardware-preflight.test.mjs",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --grep-invert @gallery",
		"test:e2e:gallery": "playwright test --grep @gallery",
		"test:e2e:install-browser": "playwright install chromium",
		"test:e2e:install-deps": "playwright install-deps chromium",
		"test:e2e:install": "playwright install chromium --with-deps",
		"test:e2e:reset": "rm -f ../backend/auth_tokens.json",
		"clean": "rm -rf dist node_modules/.vite",
		"generate:i18n": "bun run --filter @ceraui/i18n generate:i18n"
	},
	"dependencies": {
		"@ceralive/design-tokens": "^2026.6.1",
		"@ceraui/i18n": "workspace:*",
		"@ceraui/rpc": "workspace:*",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@zip.js/zip.js": "^2.8.49",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"gsap": "^3.15.0",
		"html-to-image": "^1.11.13",
		"mode-watcher": "^1.1.0",
		"qrcode": "^1.5.4",
		"svelte": "^5.56.9",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@inlang/paraglide-js": "2.23.2",
		"@lucide/svelte": "^1.31.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/svelte": "^5.4.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.2.0",
		"@types/qrcode": "^1.5.6",
		"jsdom": "^30.0.1",
		"svelte-check": "^4.7.6",
		"svelte-persistent-runes": "^2.1.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "catalog:",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10",
		"workbox-window": "^7.4.1"
	},
	"volta": {
		"node": "24.0.0"
	}
}
