{
	"root": false,
	"extends": ["@ceralive/biome-config"],
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": {
		"includes": [
			"package.json",
			"src/**/*.ts",
			"src/**/*.js",
			"src/**/*.json",
			"src/**/*.svelte",
			"vite.config.ts",
			"tailwind.config.ts",
			"pwa.config.ts",
			"svelte.config.js",
			"!**/.svelte-kit/**"
		]
	},
	"formatter": { "lineWidth": 80 },
	"javascript": {
		"globals": ["NodeJS", "__APP_VERSION__"],
		"formatter": { "quoteStyle": "double" }
	},
	"linter": {
		"rules": {
			/*
			 * staged adoption: rules the frontend did not run before 2026-11 because
			 * it did not inherit the canon; debt tracked in docs/agents/conventions.md
			 */
			"a11y": {
				"useSemanticElements": "warn",
				"useAriaPropsSupportedByRole": "warn",
				"useValidAnchor": "warn",
				"useFocusableInteractive": "warn",
				"useKeyWithClickEvents": "warn",
				"noNoninteractiveTabindex": "warn"
			},
			"suspicious": {
				"noDebugger": "warn",
				"noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } },
				"noEmptyBlockStatements": "error",
				"noExportsInTest": "warn"
			},
			"nursery": {
				"noFloatingPromises": "warn",
				"useSvelteRequireEachKey": "warn",
				"useSvelteReactiveClasses": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/tests/brand-assets-integrity.ts"],
			"formatter": { "lineWidth": 100 },
			"javascript": { "formatter": { "quoteStyle": "single" } }
		},
		{
			"includes": ["**/*.test.ts", "**/*.spec.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"useAwait": "warn",
						"noConsole": "off",
						"noEmptyBlockStatements": "off"
					},
					"nursery": {
						"noFloatingPromises": "error"
					}
				}
			}
		},
		{
			"includes": ["**/*.svelte"],
			"formatter": { "enabled": false }
		}
	]
}
