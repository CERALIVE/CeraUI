exports[`readDesiredSteeringState keeps the non-colliding state and ruleset bytes from main 2`] = `
"add table inet ceralive_share
delete table inet ceralive_share

table inet ceralive_share {
	map uplink_verdicts {
		typeof numgen random mod 10000 : verdict
		flags interval
		elements = { 0-1999 : jump select_0, 2000-9999 : jump select_1 }
	}

	chain select_0 {
		meta mark set (meta mark & 0x000000ff) | 0xca2a4800
		ct mark set (ct mark & 0x000000ff) | 0xca2a4800
		return
	}

	chain select_1 {
		meta mark set (meta mark & 0x000000ff) | 0xcaaea100
		ct mark set (ct mark & 0x000000ff) | 0xcaaea100
		return
	}

	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname "clap-wlan0" ip saddr 10.42.0.0/24 ct state established,related ct mark & 0xffffff00 == 0xca2a4800 meta mark set meta mark & 0x000000ff | 0xca2a4800 comment "restore client flow"
		iifname "clap-wlan0" ip saddr 10.42.0.0/24 ct state established,related ct mark & 0xffffff00 == 0xcaaea100 meta mark set meta mark & 0x000000ff | 0xcaaea100 comment "restore client flow"
		iifname "clap-wlan0" ip saddr 10.42.0.0/24 ct state new ct mark & 0xff000000 != 0xca000000 numgen random mod 10000 vmap @uplink_verdicts comment "select client uplink"
		iifname "eth9" ip saddr 10.43.0.0/24 ct state established,related ct mark & 0xffffff00 == 0xca2a4800 meta mark set meta mark & 0x000000ff | 0xca2a4800 comment "restore client flow"
		iifname "eth9" ip saddr 10.43.0.0/24 ct state established,related ct mark & 0xffffff00 == 0xcaaea100 meta mark set meta mark & 0x000000ff | 0xcaaea100 comment "restore client flow"
		iifname "eth9" ip saddr 10.43.0.0/24 ct state new ct mark & 0xff000000 != 0xca000000 numgen random mod 10000 vmap @uplink_verdicts comment "select client uplink"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		iifname "clap-wlan0" ip saddr 10.42.0.0/24 ct mark & 0xffffff00 == 0xca2a4800 oifname "wlan0" masquerade comment "client flow NAT"
		iifname "clap-wlan0" ip saddr 10.42.0.0/24 ct mark & 0xffffff00 == 0xcaaea100 oifname "wwan0" masquerade comment "client flow NAT"
		iifname "eth9" ip saddr 10.43.0.0/24 ct mark & 0xffffff00 == 0xca2a4800 oifname "wlan0" masquerade comment "client flow NAT"
		iifname "eth9" ip saddr 10.43.0.0/24 ct mark & 0xffffff00 == 0xcaaea100 oifname "wwan0" masquerade comment "client flow NAT"
	}
}
"
`;
