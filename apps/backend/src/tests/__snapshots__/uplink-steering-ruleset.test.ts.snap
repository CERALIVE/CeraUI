	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname "clap-wlan0" ip saddr 10.42.0.0/24 ct state established,related ct mark & 0xff000000 == 0xca000000 meta mark set (meta mark & 0x000000ff) | (ct mark & 0xffffff00) comment "restore client flow"
