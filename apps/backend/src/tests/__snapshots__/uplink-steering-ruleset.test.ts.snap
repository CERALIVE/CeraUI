exports[`buildShareRuleset has exact golden output for the declared zero-through-six target: uplinks-0 1`] = `
"destroy table inet ceralive_share

table inet ceralive_share {
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname "clap-wlan0" ip saddr 10.42.0.0/24 ct state established,related ct mark & 0xff000000 == 0xca000000 meta mark set (meta mark & 0x000000ff) | (ct mark & 0xffffff00) comment "restore client flow"
		iifname "eth9" ip saddr 10.43.0.0/24 ct state established,related ct mark & 0xff000000 == 0xca000000 meta mark set (meta mark & 0x000000ff) | (ct mark & 0xffffff00) comment "restore client flow"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}
"
`;

