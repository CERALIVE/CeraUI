{
	"name": "@ceraui/i18n",
	"version": "2026.6.1",
	"description": "Typesafe internationalization package for CeraUI",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./svelte": {
			"types": "./src/svelte.svelte.ts",
			"import": "./src/svelte.svelte.ts"
		},
		"./i18n-svelte5": {
			"types": "./src/i18n-svelte5.svelte.ts",
			"import": "./src/i18n-svelte5.svelte.ts"
		},
		"./formatters": {
			"types": "./src/formatters.ts",
			"import": "./src/formatters.ts"
		}
	},
	"scripts": {
		"dev": "typesafe-i18n",
		"build": "typesafe-i18n --no-watch && bun run check",
		"check": "node ../../scripts/tsc.mjs --compiler-package typescript-7 --noEmit",
		"test": "bun test",
		"fixtures": "bun scripts/generate-fixtures.ts",
		"convert-catalog": "bun scripts/convert-catalog.ts",
		"compile-messages": "bun scripts/compile-messages.ts",
		"generate-registry": "bun scripts/generate-registry.ts",
		"generate:i18n": "bun scripts/compile-messages.ts && bun scripts/generate-registry.ts",
		"typesafe-i18n": "typesafe-i18n --no-watch",
		"postinstall": "typesafe-i18n --no-watch",
		"prepare": "typesafe-i18n --no-watch"
	},
	"dependencies": {
		"typesafe-i18n": "^5.27.1"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.23.2",
		"typescript": "catalog:",
		"typescript-7": "npm:typescript@^7.0.2"
	},
	"keywords": [
		"i18n",
		"internationalization",
		"typesafe",
		"svelte",
		"typescript"
	],
	"license": "GPL-3.0"
}
