{
	"name": "@ceraui/i18n",
	"version": "2026.6.1",
	"description": "Internationalization package for CeraUI — inlang catalogs compiled by Paraglide",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./svelte": {
			"types": "./src/svelte.svelte.ts",
			"import": "./src/svelte.svelte.ts"
		},
		"./formatters": {
			"types": "./src/formatters.ts",
			"import": "./src/formatters.ts"
		},
		"./eager": {
			"types": "./generated/eager.d.ts",
			"import": "./generated/eager.js"
		}
	},
	"scripts": {
		"check": "bun run generate:i18n && bun ../../scripts/tsc.mjs --noEmit",
		"test": "bun run generate:i18n && bun test",
		"compile-messages": "bun scripts/compile-messages.ts",
		"generate-registry": "bun scripts/generate-registry.ts",
		"generate:i18n": "bun scripts/compile-messages.ts && bun scripts/generate-registry.ts"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.25.0",
		"svelte": "^5.56.10",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"i18n",
		"internationalization",
		"paraglide",
		"inlang",
		"svelte",
		"typescript"
	],
	"license": "GPL-3.0"
}
