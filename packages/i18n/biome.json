{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": {
		"includes": [
			"scripts/generate-registry.ts",
			"tests/catalog-duplicate-key-gate.test.ts",
			"tests/eager-registration.test.ts",
			"tests/streaming-refusal-copy.test.ts",
			"tests/translation-quality.test.ts",
			"tests/translation-identical-exceptions.json",
			"tests/translation-debt-baseline.json",
			"package.json",
			"tsconfig.json",
			"src/**/*.ts",
			"src/**/*.js",
			"src/**/*.mjs",
			"src/**/*.json",
			"src/**/*.jsonc",
			"!src/i18n-types.ts",
			"!src/i18n-util.ts",
			"!src/i18n-util.*.ts",
			"!src/paraglide"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"noBannedTypes": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } },
				"noEmptyBlockStatements": "error"
			},
			"nursery": {
				"noFloatingPromises": "warn"
			}
		}
	}
}
